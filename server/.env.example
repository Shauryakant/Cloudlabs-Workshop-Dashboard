# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Replace with your MongoDB Atlas or local MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/cloudlabs_dashboard

# Workshop Configuration
WORKSHOP_NAME=Azure Cloud Architecture Hands-on Lab
WORKSHOP_TOTAL_STEPS=8
DEFAULT_HOURLY_RATE=1.50

# Simulation Configuration
ENABLE_SIMULATION=true
SIMULATION_INTERVAL_MS=20000

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
